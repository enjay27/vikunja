# Copy to .env on the NAS and fill in. .env is never committed.
# The address the reverse proxy serves, with the trailing slash.
VIKUNJA_SERVICE_PUBLICURL=https://tasks.example.com/
# A long random string (for example: openssl rand -hex 32). Changing it signs everyone out.
VIKUNJA_SERVICE_SECRET=change-me
VIKUNJA_SERVICE_TIMEZONE=Asia/Seoul
